      "type": "n8n-nodes-plug-database.plugDatabase",
      "typeVersion": 2,
      "position": [1120, 0],
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const state = $input.item.json;\nif (state.status !== 'succeeded' || state.process?.exit_code !== 0) throw new Error('A ação terminou sem código 0');\nconst streams = {stdout: [], stderr: []};\nconst offsets = {stdout: 0, stderr: 0};\nlet complete = false;\nfor (let index = 0; index < 120; index++) {\n  const page = $('Ler saida').all(0, index)[0]?.json;\n  if (!page || page.execution_id !== state.execution_id) throw new Error('Página ausente ou execução divergente');\n  for (const event of page.events) {\n    if (complete) throw new Error('Evento após completed');\n    if (event.type === 'completed') {\n      if (!event.output_complete || event.failure) throw new Error('Falha na captura da saída');\n      complete = true;\n    }\n    if (event.type === 'output') {\n      if (!(event.stream in streams) || event.offset !== offsets[event.stream]) throw new Error('Descontinuidade na saída');\n      const bytes = Buffer.from(event.data_base64, 'base64');\n      offsets[event.stream] += bytes.length;\n      if (offsets.stdout + offsets.stderr > 8 * 1024 * 1024) throw new Error('Saída do exemplo excede 8 MiB');\n      streams[event.stream].push(bytes);\n    }\n  }\n  if (complete) break;\n  if (page.terminal && page.events.length === 0) throw new Error('Saída sem evento completed');\n}\nif (!complete) throw new Error('Saída incompleta');\nconst stdoutBytes = Buffer.concat(streams.stdout);\nconst stdout = stdoutBytes.toString('utf8');\nif (!Buffer.from(stdout, 'utf8').equals(stdoutBytes)) throw new Error('UTF-8 inválido');\nconst prefix = 'PLUG_REMOTE_ECHO=';\nconst lines = stdout.split(/\\r?\\n/).filter(line => line.startsWith(prefix));\nconst expected = Buffer.from($('Referencia').first().json.inputBase64, 'base64');\nif (lines.length !== 1 || !Buffer.from(lines[0].slice(prefix.length), 'utf8').equals(expected)) throw new Error('Eco divergente');\nif (offsets.stderr !== 0) throw new Error('O exemplo de eco retornou stderr');\nreturn {json: {execution_id: state.execution_id, status: state.status, exit_code: state.process.exit_code, output_complete: true, echo: expected.toString('utf8'), echo_bytes: expected.length, input_base64: expected.toString('base64'), stdout, stderr: ''}};"
      },
      "id": "b03b04b1-36a1-4808-a3ff-4045c3470cfd",
      "name": "Saida da execucao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 176]
    },
