{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "number",
      "const": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "number",
          "const": 1
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "dialect": {
          "type": "string",
          "enum": ["postgres", "mssql", "sybase"]
        },
        "identityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identityKind": {
          "type": "string",
          "enum": ["native", "provisioned", "locator"]
        },
        "engineVersion": {
          "type": "string",
          "maxLength": 200
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "contractVersion",
        "database",
        "dialect",
        "identityHash",
        "identityKind",
        "engineVersion",
        "verifiedAt"
      ],
      "additionalProperties": false
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "resources": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "object",
            "properties": {
              "schema": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
              },
              "type": {
                "type": "string",
                "enum": ["table", "view"]
              }
            },
            "required": ["schema", "name", "type"],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": ["available", "not_found", "not_authorized", "unavailable"]
          },
          "columns": {
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "nativeType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "ordinal": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "nullable": {
                  "type": ["boolean", "null"]
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scale": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["name", "nativeType", "ordinal", "nullable", "size", "scale"],
              "additionalProperties": false
            }
          },
          "primaryKeys": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "columns": {
                  "minItems": 1,
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "status": {
                  "enum": ["enabled", "disabled", "unvalidated", "unknown"]
                }
              },
              "required": ["name", "columns", "status"],
              "additionalProperties": false
            }
          },
          "foreignKeys": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "columns": {
                  "minItems": 1,
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "status": {
                  "enum": ["enabled", "disabled", "unvalidated", "unknown"]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 128,
                          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["table", "view"]
                    }
                  },
                  "required": ["schema", "name", "type"],
                  "additionalProperties": false
                },
                "targetColumns": {
                  "minItems": 1,
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              },
              "required": ["name", "columns", "status", "target", "targetColumns"],
              "additionalProperties": false
            }
          },
          "coverage": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "boolean"
              },
              "primaryKeys": {
                "type": "boolean"
              },
              "foreignKeys": {
                "type": "boolean"
              },
              "constraintStatus": {
                "type": "boolean"
              },
              "uniqueKeys": {
                "type": "boolean"
              }
            },
            "required": ["columns", "primaryKeys", "foreignKeys", "constraintStatus"],
            "additionalProperties": false
          },
          "limitations": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "metadata_unavailable",
                "constraint_status_unverified",
                "scoped_relationships"
              ]
            }
          },
          "uniqueKeys": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "columns": {
                  "minItems": 1,
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "status": {
                  "enum": ["enabled", "disabled", "unvalidated", "unknown"]
                }
              },
              "required": ["name", "columns", "status"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "resource",
          "status",
          "columns",
          "primaryKeys",
          "foreignKeys",
          "coverage",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "metadataPage": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["offset", "pageSize", "nextOffset"],
      "additionalProperties": false
    }
  },
  "required": ["contractVersion", "identity", "observedAt", "resources", "metadataPage"],
  "additionalProperties": false
}
