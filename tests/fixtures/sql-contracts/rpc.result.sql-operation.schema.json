{
  "additionalProperties": false,
  "description": "Journal metadata; cancellation acceptance is not rollback. Unknown outcomes must never be retried automatically. Requires sqlOperations capability version 1 on the agent.",
  "properties": {
    "completedAt": {
      "format": "date-time",
      "type": ["string", "null"]
    },
    "directlyAffectedRows": {
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "executionId": {
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "operationId": {
      "format": "uuid",
      "type": "string"
    },
    "state": {
      "enum": [
        "executando",
        "cancelamento_solicitado",
        "concluida",
        "rollback_confirmado",
        "resultado_desconhecido",
        "cancelada"
      ],
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "failureCode": {
      "type": "string",
      "enum": [
        "SOURCE_IDENTITY_MISMATCH",
        "SOURCE_STRUCTURE_MISMATCH",
        "SQL_OPERATION_CONDITION_FAILED",
        "SQL_OPERATION_ROW_LIMIT",
        "SQL_OPERATION_ROW_COUNT_UNKNOWN",
        "SQL_OPERATION_OUTPUT_INVALID",
        "SQL_OPERATION_AUTHORIZATION_CHANGED",
        "SQL_OPERATION_AUTHORIZATION_DENIED",
        "SQL_OPERATION_CANCELLED",
        "SQL_OPERATION_NATIVE_FAILED",
        "SQL_OPERATION_TIMEOUT",
        "SQL_OPERATION_INTERRUPTED",
        "SQL_OPERATION_FAILED"
      ],
      "description": "Durable safe failure category, not a commit or rollback proof. Absent on older terminal records."
    }
  },
  "required": [
    "operationId",
    "fingerprint",
    "executionId",
    "state",
    "directlyAffectedRows",
    "updatedAt"
  ],
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpc.result.sql-operation.schema.json",
  "allOf": [
    {
      "if": {
        "required": ["failureCode"]
      },
      "then": {
        "properties": {
          "state": {
            "enum": ["cancelada", "rollback_confirmado", "resultado_desconhecido"]
          }
        }
      }
    }
  ]
}
