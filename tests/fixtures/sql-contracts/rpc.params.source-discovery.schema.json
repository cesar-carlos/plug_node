{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^;{}\\r\\n\\u0000]+$"
    },
    "client_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  },
  "required": ["contractVersion", "database"]
}
