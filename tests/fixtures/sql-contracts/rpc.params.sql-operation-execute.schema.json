          "type": "string",
          "enum": ["postgres", "mssql", "sybase"]
        },
        "identityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "expectedStructure": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
