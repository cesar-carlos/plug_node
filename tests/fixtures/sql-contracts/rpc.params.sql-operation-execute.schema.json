{
  "description": "SQL-operation plan for PostgreSQL, SQL Server or SQL Anywhere. Runtime additionally limits jsonEncode(params) to 2097152 UTF-8 bytes (including credential aliases) and each SQL statement to 1048576 UTF-8 bytes. JSON Schema maxLength counts characters, not bytes. Runtime also verifies bindings to prior step outputs, at least one write, row bounds, statement safety, live authorization and negotiated limits; schema validity alone does not admit execution.",
  "additionalProperties": false,
  "properties": {
    "auth": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "clientToken": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "client_token": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "contractVersion": {
      "enum": [1],
      "type": "number"
    },
    "database": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "maxAffectedRows": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "type": "integer"
