{
  "additionalProperties": false,
  "properties": {
    "auth": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "clientToken": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "client_token": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "contractVersion": {
      "enum": [1],
      "type": "number"
    },
    "database": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "operationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "sourcePhysicalId": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "expectedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "dialect", "identityHash"],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "dialect": {
          "type": "string",
          "enum": ["postgres", "mssql", "sybase"]
        },
        "identityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "contractVersion",
    "operationId",
    "fingerprint",
    "sourcePhysicalId",
    "database"
  ],
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpc.params.sql-operation-reference.schema.json"
}
