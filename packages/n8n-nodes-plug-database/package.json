{
  "name": "n8n-nodes-plug-database",
  "version": "3.7.0",
  "description": "Plug Database n8n nodes with REST and consumer socket support",
  "license": "MIT",
  "author": {
    "name": "cesar-carlos"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesar-carlos/plug_node.git",
    "directory": "packages/n8n-nodes-plug-database"
  },
  "bugs": {
    "url": "https://github.com/cesar-carlos/plug_node/issues"
  },
  "homepage": "https://github.com/cesar-carlos/plug_node/tree/main/packages/n8n-nodes-plug-database#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "plug",
    "database",
    "rest",
    "socket.io",
    "relay",
    "consumer-socket"
  ],
  "scripts": {
    "sync-shared": "node ../../scripts/sync-shared.mjs --package n8n-nodes-plug-database",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('../../.tsbuildinfo/n8n-nodes-plug-database.tsbuildinfo', { force: true });\"",
    "prebuild": "npm run clean && npm run sync-shared",
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "predev": "npm run sync-shared",
    "dev": "n8n-node dev",
    "prelint": "npm run sync-shared",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "pretest": "npm run sync-shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run sync-shared",
    "typecheck": "tsc --pretty false --noEmit",
    "release": "n8n-node release",
    "prepublishOnly": "npm run clean && npm run sync-shared && npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/PlugDatabaseAccountApi.credentials.js",
      "dist/credentials/PlugDatabaseApi.credentials.js",
      "dist/credentials/PlugDatabaseAdvancedApi.credentials.js",
      "dist/credentials/PlugDatabaseClientApi.credentials.js",
      "dist/credentials/PlugDatabaseUserApi.credentials.js",
      "dist/credentials/PluraAiAutomationsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PlugDatabase/PlugDatabase.node.js",
      "dist/nodes/PlugMcpServer/PlugMcpServer.node.js",
      "dist/nodes/PlugAiHub/PlugAiHub.node.js",
      "dist/nodes/PlugDatabaseSocketEventTrigger/PlugDatabaseSocketEventTrigger.node.js",
      "dist/nodes/PluraAiAutomationsTrigger/PluraAiAutomationsTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.28.0",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "n8n-workflow": "2.41.2",
    "prettier": "3.9.9",
    "release-it": "21.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@bwip-js/node": "4.11.4",
    "@playwright/browser-chromium": "1.63.0",
    "@zxing/library": "0.23.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.12",
    "jsonata": "2.2.2",
    "marked": "18.0.14",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "socket.io-client": "4.8.4",
    "to-words": "7.1.0",
    "zod": "3.25.76",
    "zod4": "npm:zod@4.6.5"
  },
  "type": "commonjs"
}
